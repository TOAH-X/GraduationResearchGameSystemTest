  lines:
  - name: "\u7814\u7A76\u54E1"
    message: "\u3053\u3093\u3061\u3083\u3063\u3059\uFF01\uFF01\r\n\u79C1\u304C\u958B\u767A\u3057\u305F\u5354\u529B\u30A8\u30FC\u30B8\u30A7\u30F3\u30C8\u306E\u30C6\u30B9\u30C8\u3092\u3057\u305F\u3044\u3093\u3060\uFF01"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u65E9\u901F\u3060\u3051\u3069\u30B2\u30FC\u30E0\u306B\u6311\u6226\u3057\u3066\u4ECA\u304B\u3089\u3067\u304D\u308B\u3060\u3051\u6575\u3092\u6483\u7834\u3057\u3066\u6B32\u3057\u3044\u3063\u30B9\uFF01"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u64CD\u4F5C\u65B9\u6CD5\u306F\u3053\u306E\u901A\u308A\u2193\n\u5341\u5B57\u30AD\u30FC\uFF1A\u5DE6\u53F3\u79FB\u52D5\n\u5DE6Shift\uFF1A\u4F4E\u901F\u79FB\u52D5"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u3042\u307E\u308A\u610F\u8B58\u3057\u306A\u304F\u3066\u826F\u3044\u3051\u3069\u3001\u30B9\u30B3\u30A2\u306E\u5185\u8A33\u306F\u3053\u3093\u306A\u611F\u3058\n\u30FB\u6575\u306B\u653B\u6483\uFF1A+1\n\u30FB\u6575\u3092\u6483\u7834\uFF1A+100"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u6E96\u5099\u306F\u3067\u304D\u305F\u304B\uFF1F\n\u4F1A\u8A71\u3092\u9032\u3081\u308B\u3068\u3059\u3050\u306B\u30B2\u30FC\u30E0\u304C\u59CB\u307E\u308B\u305E\n\n\u203B\u30ED\u30FC\u30C9\u306B\u6642\u9593\u304C\u639B\u304B\u308A\u30B2\u30FC\u30E0\u958B\u59CB\u307E\u3067\u6642\u9593\u304C\u639B\u304B\u308B\u5834\u5408\u304C\u3042\u308A\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
