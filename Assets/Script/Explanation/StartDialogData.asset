  lines:
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u5B9F\u9A13\u306B\u3054\u53C2\u52A0\u304F\u3060\u3055\u308A\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: fd8e762af595b6c428cafc055c9f8e98, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u6D41\u308C\u3068\u3057\u3066\u306F\u3053\u306E\u5F8C\u3001\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u904A\u3093\u3060\u3042\u3068\u30012\u56DE\u652F\u63F4\u6A5F\u4F53\u3068\u904A\u3093\u3067\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u3053\u306E\u30B2\u30FC\u30E0\u306F"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u64CD\u4F5C\u65B9\u6CD5\u306F\u4EE5\u4E0B\u306E\u901A\u308A\u3067\u3059\u3002\n\u5341\u5B57\u30AD\u30FC\uFF1A\u5DE6\u53F3\u79FB\u52D5\n\u5DE6Shift\uFF1A\u4F4E\u901F\u79FB\u52D5"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
