  m_Script: {fileID: 11500000, guid: 44c9aad00c50b7a46998baff91357674, type: 3}
  m_Name: StartDialogData
  m_EditorClassIdentifier: 
  lines:
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u5B9F\u9A13\u306B\u3054\u53C2\u52A0\u304F\u3060\u3055\u308A\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: fd8e762af595b6c428cafc055c9f8e98, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u672C\u5B9F\u9A13\u306E\u6D41\u308C\u3068\u3057\u3066\u306F\u3053\u306E\u5F8C\u3001\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u904A\u3093\u3060\u3042\u3068\u30012\u56DE\u652F\u63F4\u6A5F\u4F53\u3068\u904A\u3093\u3067\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u3053\u306E\u30B2\u30FC\u30E0\u306F\u6575\u306E\u5F3E\u3092\u907F\u3051\u306A\u304C\u3089\u6575\u3092\u6483\u7834\u3059\u308B\u7E26\u578B\u30B7\u30E5\u30FC\u30C6\u30A3\u30F3\u30B0\u30B2\u30FC\u30E0\u3067\u3059\u3002"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u64CD\u4F5C\u65B9\u6CD5\u306F\u4EE5\u4E0B\u306E\u901A\u308A\u3067\u3059\u3002\n\u5341\u5B57\u30AD\u30FC\uFF1A\u5DE6\u53F3\u79FB\u52D5\n\u5DE6Shift\uFF1A\u4F4E\u901F\u79FB\u52D5"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u30B9\u30B3\u30A2\u306E\u5185\u8A33\u306F\u4EE5\u4E0B\u306E\u901A\u308A\u3067\u3059\u3002\n\u30FB\u6575\u306B\u653B\u6483+1\n\u30FB\u6575\u3092\u6483\u7834+100"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u88AB\u5F3E\u306F\u4F55\u5EA6\u3057\u3066\u3082\u30B2\u30FC\u30E0\u30AA\u30FC\u30D0\u30FC\u306B\u306A\u3089\u306A\u3044\u3067\u3059\u304C\u3001\u4E00\u5B9A\u6642\u9593\u653B\u6483\u304C\u3067\u304D\u306A\u304F\u306A\u308A\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u30A2\u30F3\u30B1\u30FC\u30C8\u306E\u56DE\u7B54\u3082\u4F75\u305B\u3066\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3057\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u521D\u3081\u306B\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u904A\u3093\u3067\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: cc44e3934beb0214a846555cc68a9aff, type: 3}
