  m_Script: {fileID: 11500000, guid: 44c9aad00c50b7a46998baff91357674, type: 3}
  m_Name: StartDialogData
  m_EditorClassIdentifier: 
  lines:
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u5B9F\u9A13\u306B\u3054\u53C2\u52A0\u304F\u3060\u3055\u308A\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: 18640e0bfae52424aafd83b902f57379, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u672C\u5B9F\u9A13\u306F\u300C\u5F37\u5316\u5B66\u7FD2\u3092\u7528\u3044\u305F\u30B7\u30E5\u30FC\u30C6\u30A3\u30F3\u30B0\u30B2\u30FC\u30E0\u306B\u304A\u3051\u308B\u30D7\u30EC\u30A4\u30E4\u30FC\u306B\u5FDC\u3058\u305F\u5354\u8ABF\u7684\u652F\u63F4\u884C\u52D5\u306E\u7372\u5F97\u300D\u306E\u8A55\u4FA1\u3092\u76EE\u7684\u3068\u3057\u3066\u5B9F\u65BD\u3057\u3066\u3044\u307E\u3059\u3002\n\u307E\u305F\u3001\u5148\u306B\u30A2\u30F3\u30B1\u30FC\u30C8\u306E\u5185\u5BB9\u306B\u76EE\u3092\u901A\u3057\u3066\u3044\u305F\u3060\u304F\u3053\u3068\u3092\u63A8\u5968\u3057\u3066\u3044\u307E\u3059\u3002"
    characterImage: {fileID: 21300000, guid: 18640e0bfae52424aafd83b902f57379, type: 3}
  - name: "\uFF1F\uFF1F\uFF1F"
    message: "\u3053\u308C\u304B\u3089\u3042\u306A\u305F\u306B\u306F\u3001\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u5F8C\u306B\u3001\"\u652F\u63F4\u6A5F\u4F53\"\u3068\u904A\u3093\u3067\u3044\u305F\u3060\u304D\u3001\u6700\u5F8C\u306B\u30A2\u30F3\u30B1\u30FC\u30C8\u306B\u56DE\u7B54\u3057\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3002\n\u4EE5\u5F8C\u306F\u30A8\u30FC\u30B8\u30A7\u30F3\u30C8\u306B\u5F93\u3063\u3066\u5B9F\u9A13\u3092\u9032\u3081\u3066\u304F\u3060\u3055\u3044\u3002"
    characterImage: {fileID: 21300000, guid: 18640e0bfae52424aafd83b902f57379, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u2026\u2026\u3002 "
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u3053\u3093\u3061\u3083\u3063\u3059\uFF01\uFF01\r\n\u65E9\u901F\u3060\u3051\u3069\u4ECA\u304B\u3089\u3067\u304D\u308B\u3060\u3051\u6575\u3092\u6483\u7834\u3057\u3066\u6B32\u3057\u3044\u3063\u30B9\uFF01"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u64CD\u4F5C\u65B9\u6CD5\u306F\u3053\u306E\u901A\u308A\u2193\n\u5341\u5B57\u30AD\u30FC\uFF1A\u5DE6\u53F3\u79FB\u52D5\n\u5DE6Shift\uFF1A\u4F4E\u901F\u79FB\u52D5"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u3042\u307E\u308A\u610F\u8B58\u3057\u306A\u304F\u3066\u826F\u3044\u3051\u3069\u3001\u30B9\u30B3\u30A2\u306E\u5185\u8A33\u306F\u3053\u3093\u306A\u611F\u3058\n\u30FB\u6575\u306B\u653B\u6483\uFF1A+1\n\u30FB\u6575\u3092\u6483\u7834\uFF1A+100"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u521D\u3081\u306B\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u306E\u5B9F\u9A13\u3092\u884C\u3046\u304B\u3089\u30011\u5206\u9593\u3067\u306A\u308B\u3079\u304F\u305F\u304F\u3055\u3093\u306E\u6575\u3092\u5012\u3057\u3066\u307B\u3057\u3044\u3063\u30B9\uFF01"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u4E00\u5FDC\u3001\u6575\u306E\u5F3E\u306B\u5F53\u305F\u3063\u3066\u3082\u5FA9\u6D3B\u3059\u308B\u304B\u3089\u5B89\u5FC3\u3057\u3066\u304F\u308C\uFF01"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u3053\u308C\u306F\"\u30D5\u30EA\"\u3067\u306F\u306A\u3044\u3051\u3069\u3001\u5B9F\u529B\u3092\u6E2C\u308B\u304B\u3089\u672C\u6C17\u3067\u81E8\u3093\u3067\u304F\u308C\u3088\u306A"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
  - name: "\u7814\u7A76\u54E1"
    message: "\u2026\u2026\u6E96\u5099\u306F\u3067\u304D\u305F\u3063\u30B9\u304B\uFF1F"
    characterImage: {fileID: 21300000, guid: 40ec1316624a5824386338c691cd8034, type: 3}
